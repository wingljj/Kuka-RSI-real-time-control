&ACCESS RVP
&REL 1
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF PoseTrack( )

; =============================================================================
;  RSI POSCORR 实时位姿跟踪
;    参考坐标系：BASE（在 PoseTrack.rsi 的 POSCORR1.RefCorrSys 里设定）
;    修正模式：  RELATIVE（由下面的 RSI_ON(#RELATIVE) 决定）
;
;  上位机：rsi_host.exe，监听 192.168.44.1:59152
;
;  必读的四条约束：
;
;  1) 与现有的 AXISCORR 程序互斥，不可同时运行。
;     同时给 RKorr 与 AKorr 供值，行为不可预测。
;
;  2) 本程序不修改 $TOOL / $BASE，沿用你执行它时激活的坐标系。
;     修正量是相对 BASE 解释的，所以选错基坐标系 = 机器人朝错误方向走。
;     启动前请在示教器上确认当前工具号与基坐标号。
;
;  3) 首条运动指令是 PTP $POS_ACT —— 在当前位置原地完成 BCO，零位移。
;     不要改成 PTP HOME：那会先把机器人甩到别处去。
;
;  4) RSI_MOVECORR() 是阻塞的，一直执行到 RSI 结束才返回。
;     不需要自己写 WHILE 循环去"保持"它。
;
;  安全：本程序里没有任何东西是急停。急停只有示教器上的物理急停按钮。
;        上位机界面上的「停止跟踪」只是把误差归零、机器人停在原地，
;        它仍然在持续回包 —— 一旦停止回包，RSI 会判通信故障并报错停机。
;
;  首次联机顺序（详见 docs/deployment.md）：
;     T1 模式 -> 上位机把 Kp 调到 0.1、限速 10mm/s、累积上限 10mm
;     -> 启动本程序做 BCO（机器人不应移动）-> 确认上位机读数与误差为 0
;     -> 才勾选「使能跟踪」-> 单轴加 2mm 试探。
; =============================================================================

DECL INT ret
DECL INT CONTID

;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

; ── 原地 BCO ──────────────────────────────────────────────────────────────
; 以当前位置作为起点，不产生任何实际位移。RSI 的修正量、以及 POSCORR /
; POSCORRMON 的限值，全部相对这一刻的位姿测量。
PTP $POS_ACT

; ── 建立 RSI 上下文 ───────────────────────────────────────────────────────
; 加载对象图。PoseTrack.rsi 内部通过 ETHERNET1 的 ConfigFile 参数
; 再引用 PoseTrack_ethernet.xml，后者定义 IP、端口与收发元素。
ret = RSI_CREATE("PoseTrack.rsi", CONTID, TRUE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

; ── 启动 RSI，RELATIVE 修正模式 ───────────────────────────────────────────
; RELATIVE：上位机每周期发来的是【位移增量】，KRC 侧累加。
; 这也是为什么上位机必须自己做闭环——直接发目标坐标等于命令机器人
; 在一个插补周期内走完整段距离。
ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

; ── 传感器引导运动 ────────────────────────────────────────────────────────
; 阻塞至 RSI 结束（上位机停止回包、超过 Timeout、或监控对象越限）。
; 此前机器人原地待命：上位机收到首帧后会把目标置为实际位姿，误差为 0。
RSI_MOVECORR()

; ── 收尾 ──────────────────────────────────────────────────────────────────
ret = RSI_OFF()
IF (ret <> RSIOK) THEN
  HALT
ENDIF

END
