&ACCESS RVP
&REL 4
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM EDITMASK = *
DEF PoseTrack( )

; =============================================================================
;  RSI POSCORR realtime pose tracking
;    Reference frame : BASE   (set in PoseTrack.rsix, POSCORR1.RefCorrSys = 1)
;    Correction mode : RELATIVE
;    Host            : rsi_host.exe listening on 192.168.44.1:59152
;
;  NOTE This file must stay pure ASCII. The KRL editor on the smartHMI reads
;       source files as a single-byte codepage, so UTF-8 comments show up as
;       garbage on the teach pendant.
;
;  FOUR THINGS TO KNOW
;
;  1) Mutually exclusive with any AXISCORR program. Feeding RKorr and AKorr at
;     the same time is undefined behaviour.
;
;  2) This program does NOT touch $TOOL / $BASE. It uses whatever is active when
;     you start it. Corrections are interpreted relative to BASE, so the wrong
;     base frame means the robot moves in the wrong direction. Check the active
;     tool and base numbers on the pendant before starting.
;
;  3) The first motion statement is PTP $POS_ACT - an in-place BCO with zero
;     displacement. Do not change it to PTP HOME: that would fling the robot
;     somewhere else first.
;
;  4) RSI_MOVECORR() blocks until RSI ends. You do not need a WHILE loop to
;     keep it alive.
;
;  SAFETY Nothing in this program is an emergency stop. The only emergency stop
;         is the physical E-stop button on the teach pendant. The host GUI's
;         "stop tracking" only zeroes the error and holds position - it keeps
;         replying every cycle, because a host that stops replying makes RSI
;         declare a communication fault and error-stop the robot.
;
;  FIRST COMMISSIONING RUN (see docs/deployment.md)
;     T1 mode -> set host kp to 0.1, vmax 10 mm/s, and verify the measured cycle
;     -> start this program, do the BCO (the robot must not move)
;     -> confirm the host shows zero error on all six components
;     -> only then tick "enable tracking" -> nudge X by 2 mm
; =============================================================================

DECL INT ret
DECL INT CONTID

;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

; --- In-place BCO ----------------------------------------------------------
; Start from the current position, producing no displacement. The RSI
; corrections, and the POSCORR / POSCORRMON limits, are all measured relative
; to the pose at this instant.
PTP $POS_ACT

; --- Create the RSI context ------------------------------------------------
; No file extension here on purpose: RSI 5.0 appends .rsix itself. Passing
; "PoseTrack.rsi" makes it look for PoseTrack.rsi.rsix and report file-not-found.
; The object graph in turn references PoseTrack_ethernet.xml through the
; Ethernet object's ConfigFile parameter; that file holds the IP, the port and
; the send/receive element lists.
ret = RSI_CREATE("PoseTrack", CONTID, TRUE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

; --- Start RSI in RELATIVE correction mode ---------------------------------
; RELATIVE: what the host sends each cycle is a per-cycle DISPLACEMENT
; INCREMENT, which the controller accumulates. This is why the host has to run
; its own closed loop - sending an absolute target coordinate would command the
; robot to cover that whole distance within one interpolation cycle.
ret = RSI_ON(#RELATIVE)
IF (ret <> RSIOK) THEN
  HALT
ENDIF

; --- Sensor guided motion --------------------------------------------------
; Blocks until RSI ends (host stops replying, Timeout exceeded, or a monitoring
; object trips). Until then the robot holds position: the host sets its target
; to the actual pose on the first frame, so the error starts at zero.
RSI_MOVECORR()

; --- Shutdown --------------------------------------------------------------
ret = RSI_OFF()
IF (ret <> RSIOK) THEN
  HALT
ENDIF

END
