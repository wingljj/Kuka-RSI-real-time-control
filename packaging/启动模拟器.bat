@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================
echo  KRC 模拟器 - 假装成一台 KUKA 控制器，用来测试上位机
echo ============================================================
echo.
echo  目标  : 192.168.44.1:59152
echo  周期  : 12 ms
echo  时长  : 约 8 小时（240 万个周期）
echo.
echo  用法：先运行 rsi_host.exe，再运行本脚本。
echo        关闭本窗口即停止发送。
echo.
echo  注意：这不是真机。它不实现 RSI 侧的任何限值，
echo        所以在它上面能走的距离，真机上未必允许。
echo.
echo ============================================================
echo.

krc_simulator.exe --host 192.168.44.1 --port 59152 --cycle-ms 12 --cycles 2400000

echo.
echo 模拟器已结束。
pause
