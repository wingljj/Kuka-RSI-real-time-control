/* ================================================================
   rsi_host — 浅色工业监控仪表盘样式
   颜色系统: bg=#F4F6F8  card=#FFFFFF  主色=#2563EB
   正常=#16A34A  警告=#D97706  故障=#DC2626  边框=#D9E0E7
   间距: 控件内边距 6px, 卡片间距 12px, 区块间距 16px
   ================================================================ */

/* ── 全局 ── */
QMainWindow { background-color: #F4F6F8; }
QWidget {
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10px;
    color: #1F2937;
}

/* ── 按钮 ── */
QPushButton {
    padding: 4px 10px;
    border: 1px solid #D9E0E7;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #1F2937;
    min-height: 24px;
    font-size: 10px;
}
QPushButton:hover  { background-color: #EFF6FF; border-color: #2563EB; }
QPushButton:pressed { background-color: #DBEAFE; }
QPushButton:disabled {
    background-color: #F9FAFB; color: #9CA3AF; border-color: #E5E7EB;
}

/* 主操作按钮 */
QPushButton[cssClass="primary"] {
    background-color: #2563EB; color: #FFFFFF; border-color: #2563EB;
    font-weight: bold;
}
QPushButton[cssClass="primary"]:hover { background-color: #1D4ED8; }

QPushButton[cssClass="secondary"] {
    color: #475569;
    border-color: #CBD5E1;
    background-color: #FFFFFF;
}
QPushButton[cssClass="secondary"]:hover { background-color: #F8FAFC; }

QPushButton[cssClass="warning"] {
    color: #B45309;
    border-color: #F59E0B;
    background-color: #FFFBEB;
}
QPushButton[cssClass="warning"]:hover { background-color: #FEF3C7; }

/* 危险按钮 */
QPushButton[cssClass="danger"] {
    color: #DC2626; border-color: #DC2626;
}
QPushButton[cssClass="danger"]:hover { background-color: #FEF2F2; }

/* ── 输入框 ── */
QLineEdit, QSpinBox, QDoubleSpinBox {
    padding: 3px 6px;
    border: 1px solid #D9E0E7;
    border-radius: 4px;
    background-color: #FFFFFF;
    min-height: 24px;
    font-size: 10px;
    color: #1F2937;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563EB;
}

/* ── 下拉框 ── */
QComboBox {
    padding: 3px 6px;
    border: 1px solid #D9E0E7;
    border-radius: 4px;
    background-color: #FFFFFF;
    min-height: 24px;
    font-size: 10px;
}

/* ── 分组框 / 卡片 ── */
QGroupBox {
    border: 1px solid #D9E0E7;
    border-radius: 6px;
    margin-top: 12px;
    padding: 16px 12px 8px 12px;
    background-color: #FFFFFF;
    font-weight: bold;
    font-size: 11px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #1F2937;
}

/* ── 标签 ── */
QLabel { color: #1F2937; }
QLabel[cssClass="secondary"] { color: #64748B; }
QLabel[cssClass="fieldLabel"] { color: #64748B; }
/* 只读数值：等宽字体让小数点对齐，读参数时一眼能看出量级差异 */
QLabel[cssClass="readout"] {
    font-family: Consolas, monospace;
    font-size: 10px;
    color: #1F2937;
    padding: 1px 6px;
}

/* ── 进度条 ── */
QProgressBar {
    border: 1px solid #D9E0E7;
    border-radius: 3px;
    background: #F3F4F6;
    height: 14px;
    text-align: center;
    font-size: 8px;
}
QProgressBar::chunk { border-radius: 2px; }

/* ── 表格 ── */
QTableWidget {
    border: 1px solid #D9E0E7;
    gridline-color: #F3F4F6;
    background-color: #FFFFFF;
    selection-background-color: #EFF6FF;
    font-size: 10px;
}
QHeaderView::section {
    background-color: #F9FAFB;
    border: none;
    border-bottom: 2px solid #D9E0E7;
    padding: 4px 8px;
    font-weight: bold;
    font-size: 9px;
    color: #64748B;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    width: 8px; background: #F9FAFB; border: none;
}
QScrollBar::handle:vertical {
    background: #D1D5DB; border-radius: 4px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── 分割器 ── */
QSplitter::handle { background-color: #D9E0E7; width: 1px; }

/* ── 工具提示 ── */
QToolTip {
    background-color: #1F2937; color: #FFFFFF;
    border: none; padding: 4px 8px; border-radius: 4px;
    font-size: 9px;
}
